classDiagram
    %% PawPal+ draft UML — single owner, single pet, one day, multiple time blocks.
    %% Refine this as implementation reveals gaps (see reflection.md 1b).

    class Owner {
        +str name
        +List~Pet~ pets
        add_pet(pet: Pet) None
        get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        add_task(task: Task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str preferred_block
        +bool completed
        +Pet pet
        mark_complete() None
    }

    class TimeBlock {
        +str label
        +str start_time
        +str end_time
        duration_minutes() int
    }

    %% TODO: sort_tasks priority ties currently break by shorter duration — revisit tie-break rule later
    class Scheduler {
        build_plan(tasks: List~Task~, time_blocks: List~TimeBlock~) Plan
        sort_tasks(tasks: List~Task~) List~Task~
    }

    class Plan {
        +List~ScheduledTask~ scheduled_tasks
        +List~Task~ dropped_tasks
        explain() str
    }

    class ScheduledTask {
        +Task task
        +str block_label
        +str start_time
    }

    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" Task : has
    Task "many" --> "1" Pet : belongs to
    Scheduler ..> Plan : creates
    Scheduler ..> TimeBlock : uses
    Plan "1" --> "many" ScheduledTask : contains
    Plan "1" --> "many" Task : dropped
